(ns provisiontrade.store
  "SSoT for the food/beverage/tobacco wholesale actor, behind a `Store`
  protocol so the backend is a swap, not a rewrite -- the same seam
  every prior `cloud-itonami-isic-*` actor in this fleet uses.

    - `MemStore`     -- atom of EDN. The deterministic default for
                        dev/tests/demo (no deps).
    - `DatomicStore` -- backed by `langchain.db`, a Datomic-API-compatible
                        EAV store (datalog q / pull / upsert). Pure `.cljc`,
                        so it runs offline AND can be pointed at a real
                        Datomic Local or a kotoba-server pod by swapping
                        `langchain.db`'s `:db-api` (see langchain.kotoba-db).

  Both implement the same protocol and pass the same contract
  (test/provisiontrade/store_contract_test.cljk), which is the whole
  point: the actor, the Provision Trading Governor and the audit ledger
  never know which SSoT they run on.

  Like the fuel-wholesale and agri-wholesale siblings' own entities,
  this vertical's `dispatch` and `settle` actuation events apply
  SEQUENTIALLY to the SAME `provision-order` -- a delivery happens first
  (food/beverage/tobacco product leaves the wholesale warehouse),
  invoice settlement happens later, on the same order record. This
  matches the sequential dual-actuation shape, with dedicated
  double-actuation-guard booleans (`:dispatched?`/`:invoiced?`, never a
  `:status` value).

  The `provision-order` record carries a `:consignment-category`
  (`:food` | `:beverage-non-alcoholic` | `:beverage-alcoholic` |
  `:tobacco`) that routes which regulatory-class certificate boolean(s)
  `provisiontrade.governor` actually checks -- `:food-safety-
  certificate?` for `:food`/`:beverage-non-alcoholic`,
  `:alcohol-excise-license?` for `:beverage-alcoholic`, and BOTH
  `:tobacco-excise-registration?`/`:age-verification-on-file?` for
  `:tobacco` -- see `provisiontrade.facts` and `provisiontrade.governor`
  for why ISIC 4630 needs this three-way split where the single-
  commodity fuel-wholesale sibling does not.

  The ledger stays append-only on every backend: 'which provision-order
  was verified for a jurisdiction with no official spec-basis, which
  counterparty had credit-uncleared / no contract / a missing food-
  safety certificate / alcohol excise licence / tobacco excise
  registration or age-verification record / an unresolved sanctions-
  screening flag, which order was dispatched, which invoice was
  settled, on what jurisdictional and regulatory basis, approved by
  whom' is always a query over an immutable log -- the audit trail a
  regulator, a counterparty, or an operator trusting a food/beverage/
  tobacco wholesale actor needs, and the evidence an operator needs if
  a delivery or an invoice is later disputed."
  (:require [provisiontrade.registry :as registry]
            [langchain.db :as d]
            [langchain-store.core :as ls]))

(defprotocol Store
  (provision-order [s id])
  (all-provision-orders [s])
  (assessment-of [s provision-order-id] "committed regulatory assessment, or nil")
  (ledger [s])
  (delivery-history [s] "the append-only provision-delivery history (provisiontrade.registry drafts)")
  (invoice-history [s] "the append-only provision-invoice history (provisiontrade.registry drafts)")
  (next-delivery-sequence [s jurisdiction] "next delivery-number sequence for a jurisdiction")
  (next-invoice-sequence [s jurisdiction] "next invoice-number sequence for a jurisdiction")
  (provision-order-already-dispatched? [s provision-order-id] "has this consignment already been dispatched?")
  (provision-order-already-invoiced? [s provision-order-id] "has this order's invoice already been settled?")
  (commit-record! [s record] "apply a committed op's record to the SSoT")
  (append-ledger! [s fact]   "append one immutable decision fact")
  (with-provision-orders [s provision-orders] "replace/seed the provision-order directory (map id->provision-order)"))

;; ----------------------------- demo data -----------------------------

(defn- base-order
  "The neutral, clean `:consignment-category :food` provision-order shape
  (every field in its safe state), so each demo order below isolates
  exactly ONE failure mode by overriding a single field."
  [overrides]
  (merge {:id "po-1" :order-id "PO-2026-0001" :consignment-category :food
          :product-description "Shelf-stable canned vegetables (case pack)"
          :quantity 4000 :unit "cases"
          :counterparty "Akita Provisions Wholesale Co" :price 18.75
          :contract-terms "FOB warehouse, net 30 days"
          :credit-cleared? true :sanctions-screened? true
          :food-safety-certificate? true
          :alcohol-excise-license? true
          :tobacco-excise-registration? true :age-verification-on-file? true
          :dispatched? false :invoiced? false
          :jurisdiction "JPN" :status :intake
          :dispatch-number nil :invoice-number nil}
         overrides))

(defn demo-data
  "A small, self-contained provision-order set covering both actuation
  lifecycles (delivery, invoice settlement) plus the Provision Trading
  Governor's own checks -- including ALL FOUR consignment categories
  (`:food`/`:beverage-non-alcoholic`/`:beverage-alcoholic`/`:tobacco`)
  so all three category-gated checks are exercised (food-safety shared
  by TWO categories, alcohol-excise and tobacco-excise-age-verification
  each their own) -- so the actor + tests run offline. Each violation
  order isolates exactly ONE failure mode (the rest stay clean)
  following the 'exercise the failure mode directly, never only via a
  happy-path actuation' discipline every sibling governor's demo data
  establishes."
  []
  {:provision-orders
   (into {}
         (for [o [(base-order {:id "po-1" :order-id "PO-2026-0001"})
                  (base-order {:id "po-2" :order-id "PO-2026-0002"
                               :counterparty "Atlantis Provisions Ltd"
                               :jurisdiction "ATL"})
                  (base-order {:id "po-3" :order-id "PO-2026-0003"
                               :counterparty "Cedar Foods Co"
                               :credit-cleared? false})
                  (base-order {:id "po-4" :order-id "PO-2026-0004"
                               :counterparty "Delta Provisions BV"
                               :contract-terms nil})
                  (base-order {:id "po-5" :order-id "PO-2026-0005"
                               :counterparty "Eagle Foods SA"
                               :sanctions-screened? false})
                  (base-order {:id "po-6" :order-id "PO-2026-0006"
                               :counterparty "Foxtrot Canning Co"
                               :food-safety-certificate? false})
                  (base-order {:id "po-7" :order-id "PO-2026-0007"
                               :consignment-category :beverage-alcoholic
                               :product-description "Blended whisky (case pack, 12x750ml)"
                               :quantity 800 :unit "cases"
                               :counterparty "Golden Hills Spirits Traders"
                               :price 145.00})
                  (base-order {:id "po-8" :order-id "PO-2026-0008"
                               :consignment-category :beverage-alcoholic
                               :product-description "Craft lager (keg)"
                               :quantity 300 :unit "kegs"
                               :counterparty "Highland Brewers Traders"
                               :price 95.00
                               :alcohol-excise-license? false})
                  (base-order {:id "po-9" :order-id "PO-2026-0009"
                               :consignment-category :tobacco
                               :product-description "Filtered cigarettes (case pack)"
                               :quantity 500 :unit "cases"
                               :counterparty "Ironwood Tobacco Traders"
                               :price 210.00})
                  (base-order {:id "po-10" :order-id "PO-2026-0010"
                               :consignment-category :tobacco
                               :product-description "Cigars (box pack)"
                               :quantity 150 :unit "boxes"
                               :counterparty "Juniper Tobacco Traders"
                               :price 260.00
                               :tobacco-excise-registration? false})
                  (base-order {:id "po-11" :order-id "PO-2026-0011"
                               :consignment-category :tobacco
                               :product-description "Roll-your-own tobacco (pouch pack)"
                               :quantity 220 :unit "cases"
                               :counterparty "Kestrel Tobacco Traders"
                               :price 175.00
                               :age-verification-on-file? false})
                  (base-order {:id "po-12" :order-id "PO-2026-0012"
                               :consignment-category :beverage-non-alcoholic
                               :product-description "Sparkling fruit juice (case pack)"
                               :quantity 2500 :unit "cases"
                               :counterparty "Lighthouse Beverage Traders"
                               :price 22.50})]]
           [(:id o) o]))})

;; ----------------------------- shared commit logic -----------------------------

(defn- deliver-order!
  "Backend-agnostic `:order/mark-dispatched` -- looks up the provision-
  order via the protocol and drafts the provision-delivery record, and
  returns {:result .. :provision-order-patch ..} for the caller to
  persist."
  [s provision-order-id]
  (let [po (provision-order s provision-order-id)
        seq-n (next-delivery-sequence s (:jurisdiction po))
        result (registry/register-delivery-record provision-order-id (:jurisdiction po) seq-n)]
    {:result result
     :provision-order-patch {:dispatched? true
                             :dispatch-number (get result "delivery_number")}}))

(defn- invoice-order!
  "Backend-agnostic `:order/mark-invoiced` -- looks up the provision-
  order via the protocol and drafts the provision-invoice record, and
  returns {:result .. :provision-order-patch ..} for the caller to
  persist."
  [s provision-order-id]
  (let [po (provision-order s provision-order-id)
        seq-n (next-invoice-sequence s (:jurisdiction po))
        result (registry/register-invoice-record provision-order-id (:jurisdiction po) seq-n)]
    {:result result
     :provision-order-patch {:invoiced? true
                             :invoice-number (get result "invoice_number")}}))

;; ----------------------------- MemStore (default) -----------------------------

(defrecord MemStore [a]
  Store
  (provision-order [_ id] (get-in @a [:provision-orders id]))
  (all-provision-orders [_] (sort-by :id (vals (:provision-orders @a))))
  (assessment-of [_ provision-order-id] (get-in @a [:assessments provision-order-id]))
  (ledger [_] (:ledger @a))
  (delivery-history [_] (:deliveries @a))
  (invoice-history [_] (:invoices @a))
  (next-delivery-sequence [_ jurisdiction] (get-in @a [:delivery-sequences jurisdiction] 0))
  (next-invoice-sequence [_ jurisdiction] (get-in @a [:invoice-sequences jurisdiction] 0))
  (provision-order-already-dispatched? [_ provision-order-id] (boolean (get-in @a [:provision-orders provision-order-id :dispatched?])))
  (provision-order-already-invoiced? [_ provision-order-id] (boolean (get-in @a [:provision-orders provision-order-id :invoiced?])))
  (commit-record! [s {:keys [effect path value payload]}]
    (case effect
      :order/upsert
      (swap! a update-in [:provision-orders (:id value)] merge value)

      :regulatory-assessment/set
      (swap! a assoc-in [:assessments (first path)] payload)

      :order/mark-dispatched
      (let [provision-order-id (first path)
            {:keys [result provision-order-patch]} (deliver-order! s provision-order-id)
            jurisdiction (:jurisdiction (provision-order s provision-order-id))]
        (swap! a (fn [state]
                   (-> state
                       (update-in [:delivery-sequences jurisdiction] (fnil inc 0))
                       (update-in [:provision-orders provision-order-id] merge provision-order-patch)
                       (update :deliveries registry/append result))))
        result)

      :order/mark-invoiced
      (let [provision-order-id (first path)
            {:keys [result provision-order-patch]} (invoice-order! s provision-order-id)
            jurisdiction (:jurisdiction (provision-order s provision-order-id))]
        (swap! a (fn [state]
                   (-> state
                       (update-in [:invoice-sequences jurisdiction] (fnil inc 0))
                       (update-in [:provision-orders provision-order-id] merge provision-order-patch)
                       (update :invoices registry/append result))))
        result)
      nil)
    s)
  (append-ledger! [_ fact] (swap! a update :ledger conj fact) fact)
  (with-provision-orders [s provision-orders] (when (seq provision-orders) (swap! a assoc :provision-orders provision-orders)) s))

(defn seed-db
  "A MemStore seeded with the demo provision-order set. The
  deterministic default."
  []
  (->MemStore (atom (assoc (demo-data)
                           :assessments {}
                           :ledger [] :delivery-sequences {} :deliveries []
                           :invoice-sequences {} :invoices []))))

;; ----------------------------- DatomicStore (langchain.db) -----------------------------

(def ^:private schema
  "DataScript/Datomic-style schema: only constraint attrs are declared.
  Map/compound values (assessment payloads, ledger facts, delivery/
  invoice records) are stored as EDN strings so `langchain.db`
  doesn't expand them into sub-entities -- the same convention every
  sibling actor's store uses."
  {:provision-order/id                   {:db/unique :db.unique/identity}
   :assessment/provision-order-id        {:db/unique :db.unique/identity}
   :ledger/seq                           {:db/unique :db.unique/identity}
   :delivery/seq                         {:db/unique :db.unique/identity}
   :invoice/seq                          {:db/unique :db.unique/identity}
   :delivery-sequence/jurisdiction       {:db/unique :db.unique/identity}
   :invoice-sequence/jurisdiction        {:db/unique :db.unique/identity}})

(defn- enc [v] (ls/enc v))
(defn- dec* [s] (ls/dec* s))

;; Every provision-order field is stored as its own Datomic attr so a
;; governor pull reads the exact ground truth (no blob decode). Boolean
;; fields are coerced on read so a missing attr reads back as false
;; (parity with MemStore). [field-key tx-attr boolean?]
(def ^:private provision-order-fields
  [[:id :provision-order/id false]
   [:order-id :provision-order/order-id false]
   [:consignment-category :provision-order/consignment-category false]
   [:product-description :provision-order/product-description false]
   [:quantity :provision-order/quantity false]
   [:unit :provision-order/unit false]
   [:counterparty :provision-order/counterparty false]
   [:price :provision-order/price false]
   [:contract-terms :provision-order/contract-terms false]
   [:credit-cleared? :provision-order/credit-cleared? true]
   [:sanctions-screened? :provision-order/sanctions-screened? true]
   [:food-safety-certificate? :provision-order/food-safety-certificate? true]
   [:alcohol-excise-license? :provision-order/alcohol-excise-license? true]
   [:tobacco-excise-registration? :provision-order/tobacco-excise-registration? true]
   [:age-verification-on-file? :provision-order/age-verification-on-file? true]
   [:dispatched? :provision-order/dispatched? true]
   [:invoiced? :provision-order/invoiced? true]
   [:jurisdiction :provision-order/jurisdiction false]
   [:status :provision-order/status false]
   [:dispatch-number :provision-order/dispatch-number false]
   [:invoice-number :provision-order/invoice-number false]])

(defn- provision-order->tx [po]
  (reduce (fn [tx [k attr _bool?]]
            (let [v (get po k)]
              (cond-> tx (some? v) (assoc attr v))))
          {:provision-order/id (:id po)}
          provision-order-fields))

(def ^:private provision-order-pull (mapv second provision-order-fields))

(defn- pull->provision-order [m]
  (when (:provision-order/id m)
    (reduce (fn [po [k attr bool?]]
              (let [v (get m attr)]
                (cond
                  bool?        (assoc po k (boolean v))
                  (some? v)    (assoc po k v)
                  :else        po)))
            {:id (:provision-order/id m)}
            provision-order-fields)))

(defrecord DatomicStore [conn]
  Store
  (provision-order [_ id]
    (pull->provision-order (d/pull (d/db conn) provision-order-pull [:provision-order/id id])))
  (all-provision-orders [_]
    (->> (d/q '[:find [?id ...] :where [?e :provision-order/id ?id]] (d/db conn))
         (map #(pull->provision-order (d/pull (d/db conn) provision-order-pull [:provision-order/id %])))
         (sort-by :id)))
  (assessment-of [_ provision-order-id]
    (dec* (d/q '[:find ?p . :in $ ?poid
                :where [?a :assessment/provision-order-id ?poid] [?a :assessment/payload ?p]]
              (d/db conn) provision-order-id)))
  (ledger [_]
    (->> (d/q '[:find ?s ?f :where [?e :ledger/seq ?s] [?e :ledger/fact ?f]] (d/db conn))
         (sort-by first)
         (mapv (comp dec* second))))
  (delivery-history [_]
    (->> (d/q '[:find ?s ?r :where [?e :delivery/seq ?s] [?e :delivery/record ?r]] (d/db conn))
         (sort-by first)
         (mapv (comp dec* second))))
  (invoice-history [_]
    (->> (d/q '[:find ?s ?r :where [?e :invoice/seq ?s] [?e :invoice/record ?r]] (d/db conn))
         (sort-by first)
         (mapv (comp dec* second))))
  (next-delivery-sequence [_ jurisdiction]
    (or (d/q '[:find ?n . :in $ ?j
              :where [?e :delivery-sequence/jurisdiction ?j] [?e :delivery-sequence/next ?n]]
            (d/db conn) jurisdiction)
        0))
  (next-invoice-sequence [_ jurisdiction]
    (or (d/q '[:find ?n . :in $ ?j
              :where [?e :invoice-sequence/jurisdiction ?j] [?e :invoice-sequence/next ?n]]
            (d/db conn) jurisdiction)
        0))
  (provision-order-already-dispatched? [s provision-order-id]
    (boolean (:dispatched? (provision-order s provision-order-id))))
  (provision-order-already-invoiced? [s provision-order-id]
    (boolean (:invoiced? (provision-order s provision-order-id))))
  (commit-record! [s {:keys [effect path value payload]}]
    (case effect
      :order/upsert
      (d/transact! conn [(provision-order->tx value)])

      :regulatory-assessment/set
      (d/transact! conn [{:assessment/provision-order-id (first path) :assessment/payload (enc payload)}])

      :order/mark-dispatched
      (let [provision-order-id (first path)
            {:keys [result provision-order-patch]} (deliver-order! s provision-order-id)
            jurisdiction (:jurisdiction (provision-order s provision-order-id))
            next-n (inc (next-delivery-sequence s jurisdiction))]
        (d/transact! conn
                     [(provision-order->tx (assoc provision-order-patch :id provision-order-id))
                      {:delivery-sequence/jurisdiction jurisdiction :delivery-sequence/next next-n}
                      {:delivery/seq (count (delivery-history s)) :delivery/record (enc (get result "record"))}])
        result)

      :order/mark-invoiced
      (let [provision-order-id (first path)
            {:keys [result provision-order-patch]} (invoice-order! s provision-order-id)
            jurisdiction (:jurisdiction (provision-order s provision-order-id))
            next-n (inc (next-invoice-sequence s jurisdiction))]
        (d/transact! conn
                     [(provision-order->tx (assoc provision-order-patch :id provision-order-id))
                      {:invoice-sequence/jurisdiction jurisdiction :invoice-sequence/next next-n}
                      {:invoice/seq (count (invoice-history s)) :invoice/record (enc (get result "record"))}])
        result)
      nil)
    s)
  (append-ledger! [s fact]
    (d/transact! conn [{:ledger/seq (count (ledger s)) :ledger/fact (enc fact)}])
    fact)
  (with-provision-orders [s provision-orders]
    (when (seq provision-orders) (d/transact! conn (mapv provision-order->tx (vals provision-orders)))) s))

(defn datomic-store
  "A DatomicStore (langchain.db backend) seeded from `data`
  ({:provision-orders ..}); empty when omitted."
  ([] (datomic-store {}))
  ([{:keys [provision-orders]}]
   (let [s (->DatomicStore (d/create-conn schema))]
     (with-provision-orders s provision-orders))))

(defn datomic-seed-db
  "A DatomicStore seeded with the demo provision-order set -- the
  Datomic-backed analog of `seed-db`, used to prove protocol parity."
  []
  (datomic-store (demo-data)))
